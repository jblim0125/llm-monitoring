{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AI 코딩 에이전트(Claude Code, Copilot, OpenClaw) 전체 LLM 사용량",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "요약",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "총 입력 토큰 (선택 기간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"input\", service_name=~\"$agent\", user_name=~\"$user\"}[$__range])) or sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "총 출력 토큰 (선택 기간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"output\", service_name=~\"$agent\", user_name=~\"$user\"}[$__range])) or sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "총 비용 (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_cost_usage_USD_total{service_name=~\"$agent\", user_name=~\"$user\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "활성 세션 수",
      "description": "최근 5분 내 활동이 있던 세션. session_id별 시리즈 개수로 카운트.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(claude_code_session_count_total{service_name=~\"$agent\", user_name=~\"$user\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "시계열 — 토큰 / 비용 / 요청",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "토큰 사용량 추이 (type별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total{service_name=~\"$agent\", user_name=~\"$user\"}[$__rate_interval]))",
          "legendFormat": "claude_code/{{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[$__rate_interval]))",
          "legendFormat": "copilot/{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "일일 비용 추이 (USD/시간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total{service_name=~\"$agent\", user_name=~\"$user\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "분석 — Agent / Model / Tool",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "piechart",
      "id": 7,
      "title": "에이전트별 요청 비율 (Loki 이벤트)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$agent\", user_name=~\"$user\"} | event_name=\"api_request\" [$__range]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "barchart",
      "id": 8,
      "title": "모델별 토큰 사용량",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (model) (increase(claude_code_token_usage_tokens_total{service_name=~\"$agent\", user_name=~\"$user\"}[$__range])))",
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "id": 9,
      "title": "Top 도구 호출 (Loki 이벤트)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (tool_name, decision) (count_over_time({service_name=~\"$agent\", user_name=~\"$user\"} | event_name=\"tool_decision\" [$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "오류 / 지연 시간",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "도구 실패율 (tool_result.success=false)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_name) (rate({service_name=~\"$agent\", user_name=~\"$user\"} | event_name=\"tool_result\" | success=\"false\" [$__rate_interval]))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "API 호출 지연 시간 P50/P95 (Loki: duration_ms)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service_name=~\"$agent\", user_name=~\"$user\"} | event_name=\"api_request\" | unwrap duration_ms [$__rate_interval]) by (model)",
          "legendFormat": "p50 / {{model}}"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service_name=~\"$agent\", user_name=~\"$user\"} | event_name=\"api_request\" | unwrap duration_ms [$__rate_interval]) by (model)",
          "legendFormat": "p95 / {{model}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["llm", "monitoring", "ai-agent"],
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Agent (service_name)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(claude_code_session_count_total, service_name)", "refId": "agent" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values({__name__=~\"claude_code_.*\", service_name=~\"$agent\", user_name!=\"\"}, user_name)", "refId": "user" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(claude_code_token_usage_tokens_total, model)", "refId": "model" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LLM Overview — 토큰 / 비용 / 세션 / 모델",
  "uid": "llm-overview",
  "version": 3,
  "weekStart": ""
}
