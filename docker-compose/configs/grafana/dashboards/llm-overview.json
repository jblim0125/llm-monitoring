{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AI 코딩 에이전트(Claude Code, Copilot, OpenClaw) 전체 LLM 사용량",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "요약",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "총 입력 토큰 (선택 기간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_total{type=\"input\"}[$__range])) or sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "총 출력 토큰 (선택 기간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_total{type=\"output\"}[$__range])) or sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "총 비용 (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_cost_usage_total[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "세션 수",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_session_count_total[$__range]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "시계열 — 토큰 / 비용 / 요청",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "토큰 사용량 추이 (type별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(claude_code_token_usage_total[$__rate_interval]))",
          "legendFormat": "claude_code/{{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[$__rate_interval]))",
          "legendFormat": "copilot/{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "일일 비용 추이 (USD/시간)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(claude_code_cost_usage_total[$__rate_interval])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "분석 — Agent / Model / Tool",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "piechart",
      "id": 7,
      "title": "에이전트별 요청 비율",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (increase(claude_code_api_request_total[$__range])) or sum by (agent) (increase(gen_ai_client_operation_duration_count[$__range]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "type": "barchart",
      "id": 8,
      "title": "모델별 토큰 사용량",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (model) (increase(claude_code_token_usage_total[$__range])))",
          "legendFormat": "{{model}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "id": 9,
      "title": "Top 도구 호출",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (tool, decision) (increase(claude_code_code_edit_tool_decision_total[$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "오류 / 지연 시간",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "API 오류율 (status != 200)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, model) (rate(claude_code_api_error_total[$__rate_interval]))",
          "legendFormat": "{{model}} / {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Copilot/GenAI 호출 지연 시간 (P50 / P95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "p50 / {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "p95 / {{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "최근 로그",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "type": "logs",
      "id": 12,
      "title": "최근 LLM 로그 (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 33 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"claude-code|copilot-chat|openclaw-gateway\"}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["llm", "monitoring", "ai-agent"],
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(claude_code_session_count_total, agent)", "refId": "agent" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(claude_code_token_usage_total, model)", "refId": "model" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LLM Overview — 토큰 / 비용 / 세션 / 모델",
  "uid": "llm-overview",
  "version": 1,
  "weekStart": ""
}
