  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["llm", "monitoring", "user", "team"],
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Agent (service_name)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values({__name__=~\"claude_code_.*|gen_ai_.*\"}, service_name)", "refId": "agent" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values({__name__=~\"claude_code_.*|gen_ai_.*\", service_name=~\"$agent\", team!=\"\"}, team)", "refId": "team" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values({__name__=~\"claude_code_.*|gen_ai_.*\", service_name=~\"$agent\", team=~\"$team\", user_name!=\"\"}, user_name)", "refId": "user" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
